# searchio configuration. Every value is optional -- `searchio search` works
# with this file absent entirely. Copy to .env to use.

# ── The swarm (the only thing that needs a key) ──────────────────────────────
# Backend: anthropic (default) or deepseek / any OpenAI-compatible endpoint.
# SEARCHIO_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# SEARCHIO_MODEL=claude-opus-5
#
# OpenAI-compatible backend (DeepSeek, self-hosted vLLM, ...).
# DEEPSEEK_API_KEY=sk-...
# SEARCHIO_DEEPSEEK_MODEL=deepseek-v4-pro
# SEARCHIO_DEEPSEEK_BASE_URL=https://api.deepseek.com
#
# Token prices in USD per million, used only to report a cost estimate.
# Anthropic rates are built in; set these for any other backend, or the
# run reports tokens without a dollar figure rather than guessing.
# SEARCHIO_PRICE_IN_PER_MTOK=0.28
# SEARCHIO_PRICE_OUT_PER_MTOK=0.42
# SEARCHIO_LEAD_EFFORT=high
# SEARCHIO_WORKER_EFFORT=low
# SEARCHIO_MAX_WORKERS=5
# SEARCHIO_MAX_TOOL_CALLS_PER_WORKER=12
# SEARCHIO_SWARM_TOKEN_BUDGET=400000
# SEARCHIO_SWARM_WALL_CLOCK_S=600

# ── Acquisition ladder ───────────────────────────────────────────────────────
# 0 = plain HTTP only, 1 = + TLS impersonation, 2 = + stealth browser.
# Set to 1 to guarantee searchio never spawns a browser.
# SEARCHIO_MAX_TIER=2
# SEARCHIO_MIN_TEXT_CHARS=120
# SEARCHIO_TIER0_TIMEOUT_S=8
# SEARCHIO_TIER1_TIMEOUT_S=15
# SEARCHIO_TIER2_TIMEOUT_S=90

# ── Politeness (also what keeps you unblocked -- see README) ─────────────────
# SEARCHIO_PER_DOMAIN_RPS=0.75
# SEARCHIO_PER_DOMAIN_BURST=3
# SEARCHIO_PER_DOMAIN_MAX_RPS=4.0
# SEARCHIO_GLOBAL_CONCURRENCY=24
# enforce | warn | off
# SEARCHIO_ROBOTS_POLICY=warn
#
# Egress proxy, applied to all three tiers. IP reputation is the one input
# to an anti-bot decision that fingerprint work cannot move.
# SEARCHIO_PROXY=http://user:pass@host:8080
# Browser-tier-only override, for when residential bandwidth is metered.
# SEARCHIO_BROWSER_PROXY=
# Interpreter for the sidecar; empty auto-detects one with patchright.
# SEARCHIO_SIDECAR_PYTHON=
# Optional contact string advertised on requests when you want to be identifiable.
# SEARCHIO_USER_AGENT_CONTACT=+https://example.com/bot

# ── SwarmIO browser sidecar (tier 2) ─────────────────────────────────────────
# Auto-discovered at ~/Documents/GitHub/SwarmIO if present. Otherwise point at
# crates/swarm-tools/python/browser_sidecar.py, or at an already-running one.
# SEARCHIO_SIDECAR_SCRIPT=C:/Users/you/Documents/GitHub/SwarmIO/crates/swarm-tools/python/browser_sidecar.py
# SEARCHIO_SIDECAR_URL=http://127.0.0.1:8899
# SEARCHIO_SIDECAR_PORT=8899
# SEARCHIO_SIDECAR_TOKEN=
# SEARCHIO_SIDECAR_AUTOSTART=true

# ── Cache and state ──────────────────────────────────────────────────────────
# SEARCHIO_STATE_DIR=~/.searchio
# SEARCHIO_CACHE_TTL_S=3600
# SEARCHIO_CACHE_ENABLED=true

# ── Providers ────────────────────────────────────────────────────────────────
# SEARCHIO_FANOUT=4
# SEARCHIO_PROVIDER_TIMEOUT_S=12
# Optional; raises the GitHub rate limit from 60/hr to 5000/hr.
# SEARCHIO_GITHUB_TOKEN=

# ── Facebook Marketplace ─────────────────────────────────────────────────────
# Marketplace is geolocated by exit IP. Without a city, a query answered from a
# container returns that datacentre's metro -- confidently and wrongly. Use the
# slug as it appears in the Marketplace URL.
# SEARCHIO_FACEBOOK_CITY=nyc
#
# Optional Playwright storage_state JSON. Logged out, a search caps at ~14
# listings; a session lifts that. Create the file by logging in BY HAND through
# SwarmIO's interactive_login (headed browser, no credentials captured).
# A scripted login from a fresh automation profile is the fastest way to get an
# account checkpointed, and a checkpointed account returns fewer listings than
# none at all.
# SEARCHIO_FACEBOOK_SESSION=/path/to/fb-session.json
# Commercial SERP adapters are not wired up in this build -- the keyless path
# and the stealth tier cover the same ground. These are reserved names.
# SEARCHIO_SERPAPI_KEY=
# SEARCHIO_BRAVE_KEY=
# SEARCHIO_TAVILY_KEY=

# ── Docker (see docker-compose.yml) ──────────────────────────────────────────
# Path to your SwarmIO checkout, used to build the browser-worker image.
# SWARMIO_PATH=../SwarmIO
# SEARCHIO_PORT=8080
